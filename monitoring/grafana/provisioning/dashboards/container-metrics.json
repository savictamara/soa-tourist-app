{
  "title": "Container Metrics",
  "uid": "container-metrics",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Container CPU Usage (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(container_cpu_usage_seconds_total{id=~\"/docker/[a-f0-9]+\"}[1m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" }
    },
    {
      "id": 2,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" },
          "expr": "container_memory_usage_bytes{id=~\"/docker/[a-f0-9]+\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" }
    },
    {
      "id": 3,
      "title": "Container Network Receive",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      },
      "targets": [
        {
          "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(container_network_receive_bytes_total{id=~\"/docker/[a-f0-9]+\"}[1m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" }
    },
    {
      "id": 4,
      "title": "Container Network Transmit",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      },
      "targets": [
        {
          "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(container_network_transmit_bytes_total{id=~\"/docker/[a-f0-9]+\"}[1m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" }
    },
    {
      "id": 5,
      "title": "Container Filesystem Usage (Total)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" },
          "expr": "container_fs_usage_bytes{device=\"overlay\", id=\"/\"}",
          "legendFormat": "Docker Filesystem Used",
          "refId": "A"
        }
      ],
      "datasource": { "type": "PBFA97CFB590B2093", "uid": "PBFA97CFB590B2093" }
    }
  ]
}
